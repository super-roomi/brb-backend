# Copy to .env and adjust.

# SQLite for local dev. For production use PostgreSQL, e.g.:
# DATABASE_URL="postgresql://user:pass@host:5432/barberapp?schema=public"
DATABASE_URL="file:./dev.db"

PORT=4000
NODE_ENV=development

# Long random strings in production (openssl rand -hex 32)
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# console = print OTP to server log (dev). twilio = real SMS.
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Comma-separated origins allowed to call the API (admin panel dev server)
CORS_ORIGINS=http://localhost:5173

# Seed admin credentials (used by prisma/seed.ts)
SEED_ADMIN_EMAIL=admin@barberapp.dev
SEED_ADMIN_PASSWORD=admin1234
