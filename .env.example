# Copy to .env and adjust.

# PostgreSQL. On Render the linked Postgres injects DATABASE_URL automatically.
# Local dev: run Postgres and point this at it, e.g.
#   postgresql://postgres:postgres@localhost:5432/barberapp?schema=public
# Tests are destructive — point DATABASE_URL at a THROWAWAY database when
# running `npm test`. The pretest guard REFUSES to run unless the database
# name contains "test", e.g. barberapp_test.
DATABASE_URL="postgresql://postgres@localhost:5432/barberapp?schema=public"

PORT=4000
NODE_ENV=development

# Log verbosity: trace|debug|info|warn|error|fatal|silent (default info).
# Dev prints human-readable colored logs; production emits JSON for aggregators.
LOG_LEVEL=info

# --- Secrets ---------------------------------------------------------------
# Long random strings in production (openssl rand -hex 32).
#
# Customer sessions. In production the server refuses to start if this is
# missing or still the dev placeholder.
JWT_ACCESS_SECRET=dev-access-secret-change-me
# Admin panel sessions, signed with a SEPARATE secret and audience so a leaked
# customer secret can't mint admin tokens. In production the server refuses to
# start if this is missing, still the placeholder, or equal to
# JWT_ACCESS_SECRET. Outside production it falls back to JWT_ACCESS_SECRET, so
# local dev and tests need no second value.
JWT_ADMIN_SECRET=dev-admin-secret-change-me

ACCESS_TOKEN_TTL=15m
# Admin tokens have no refresh path; a longer TTL avoids logging admins out
# mid-edit. Internal panel, so this is an acceptable trade-off.
ADMIN_ACCESS_TOKEN_TTL=8h
REFRESH_TOKEN_TTL_DAYS=30

# --- OAuth -----------------------------------------------------------------
# Google OAuth. Accepted `aud` values for Google ID tokens, comma-separated —
# list the WEB client id (what the Flutter app passes as serverClientId) and,
# if tokens ever arrive with the platform ids as audience, the Android/iOS
# client ids too. Create them in Google Cloud Console > APIs & Services >
# Credentials. Until this is set to a real value, Google sign-in returns 503
# GOOGLE_NOT_CONFIGURED and development uses /api/auth/test-login instead.
GOOGLE_CLIENT_ID=YOUR_WEB_CLIENT_ID.apps.googleusercontent.com

# Sign in with Apple. Accepted `aud` values for Apple identity tokens,
# comma-separated. For the native iOS flow this is the app's bundle id, which
# is what it defaults to — so this only needs setting to add a Service ID for a
# future web flow, or if the bundle id ever changes. No secret is required:
# tokens are verified against Apple's public keys.
APPLE_CLIENT_ID=com.barberapp.barberMobile

# NOTE: ENABLE_TEST_LOGIN no longer exists. POST /api/auth/test-login signs in
# as ANY email with no credential, so it is registered only when NODE_ENV is
# not "production" — there is deliberately no flag to turn it on, because a
# flag makes production account-takeover one mistyped dashboard value away.

# Comma-separated origins allowed to call the API (admin panel dev server)
CORS_ORIGINS=http://localhost:5173

# --- Connection pool -------------------------------------------------------
# Prisma's default pool is `hostCpuCount * 2 + 1`, which inside a container has
# nothing to do with the CPU this process actually gets — and managed Postgres
# on Render ships no PgBouncer. These are appended to DATABASE_URL by
# src/lib/prisma.ts, and only for keys the URL doesn't already set.
DB_CONNECTION_LIMIT=5
DB_POOL_TIMEOUT=10
DB_STATEMENT_TIMEOUT_MS=15000

# --- Retention -------------------------------------------------------------
# Nightly sweep trims these; expired refresh tokens are always removed.
NOTIFICATION_RETENTION_DAYS=90
AUDIT_RETENTION_DAYS=365

# --- Push ------------------------------------------------------------------
# Firebase Cloud Messaging. Optional — if unset, push is disabled and only the
# in-app notification feed is used. Paste the WHOLE service-account JSON
# (Firebase console > Project settings > Service accounts > Generate key)
# as a single-line value. Set it as a SECRET, never commit it.
#   FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...", ...}
# Alternatively point GOOGLE_APPLICATION_CREDENTIALS at a JSON file path.
FIREBASE_SERVICE_ACCOUNT=

# Seed admin credentials (used by prisma/seed.ts)
SEED_ADMIN_EMAIL=admin@barberapp.dev
SEED_ADMIN_PASSWORD=admin1234
