// Barbershop reservation platform — data model.
//
// PostgreSQL. Enum-like fields are Strings validated with Zod at the API
// boundary. Schema changes go through `prisma migrate dev`; deploys run
// `prisma migrate deploy` (wired into `npm start`).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model City {
  id        String       @id @default(cuid())
  name      String       @unique
  slug      String       @unique
  createdAt DateTime     @default(now())
  shops     Barbershop[]
}

model User {
  id            String         @id @default(cuid())
  // Google account email (lowercased). Sign-in is Google OAuth only; rows
  // migrated from the old phone era carry "<phone>@phone.migrated" until the
  // person signs in with Google and the row is linked by email.
  email         String         @unique
  // Google `sub` claim — the stable account id. Null until first Google login.
  googleId      String?        @unique
  // Apple `sub` claim — the stable account id. Null until first Apple login.
  // Sign in with Apple may hand back a private @privaterelay.appleid.com email,
  // so users are matched by this id first, not by address.
  appleId       String?        @unique
  name          String?
  // Preferred content language (en | ar | ckb), refreshed from the ?lang= the
  // app sends when it registers its device token. Used to localize push and
  // in-app notifications, which are sent outside the user's own request.
  lang          String         @default("en")
  createdAt     DateTime       @default(now())
  reservations  Reservation[]
  reviews       Review[]
  refreshTokens RefreshToken[]
  notifications Notification[]
  deviceTokens  DeviceToken[]
}

// FCM registration token for a user's device, used to deliver push
// notifications. One row per device; the token is globally unique and
// reassigned to the current user if it reappears under a new login.
model DeviceToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  platform  String   // 'android' | 'ios'
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  // Nightly retention sweep deletes rows past their expiry (see
  // services/maintenance.ts) — without this the table grows forever, roughly
  // one row per token refresh per device.
  @@index([expiresAt])
}

model Barbershop {
  id               String        @id @default(cuid())
  // Base (English) name/description; Ar/Ckb are optional translations shown in
  // the app when that language is selected, else the base is used as fallback.
  name             String
  nameAr           String?
  nameCkb          String?
  description      String
  descriptionAr    String?
  descriptionCkb   String?
  address          String
  phone            String
  imageUrl         String?
  cityId           String
  city             City          @relation(fields: [cityId], references: [id])
  // Number of chairs = how many reservations can overlap at one time.
  chairCount       Int           @default(1)
  // Grace period in minutes enforced between consecutive bookings (per barber,
  // or per chair for shops without barbers): after a booking ends, the next one
  // can't start until bufferMin minutes later. 0 = back-to-back allowed.
  bufferMin        Int           @default(0)
  // Wall-clock offset for the shop's locale (Iraq: UTC+3, no DST).
  utcOffsetMinutes Int           @default(180)
  isVisible        Boolean       @default(false)
  // Map location (nullable — shown on the customer app when both are set).
  latitude         Float?
  longitude        Float?
  // Human-friendly location label (e.g. landmark/area), optional, translatable.
  locationLabel    String?
  locationLabelAr  String?
  locationLabelCkb String?
  // Social media links (nullable — shops may set any subset).
  instagramUrl     String?
  facebookUrl      String?
  tiktokUrl        String?
  snapchatUrl      String?
  // Denormalized rating aggregate, maintained transactionally on review writes.
  ratingAvg        Float         @default(0)
  ratingCount      Int           @default(0)
  // "Barber of the Week" curated slot (1..3) + when it was set. Null = not
  // currently featured. Public feed shows these while botwSelectedAt is recent.
  botwRank         Int?
  botwSelectedAt   DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  services         Service[]
  openingHours     OpeningHour[]
  barbers          Barber[]
  reservations     Reservation[]
  reviews          Review[]
  subscription     Subscription?

  @@index([cityId, isVisible])
  // Supports the bounding-box prefilter in GET /api/shops/nearby. A partial
  // index would be tighter, but Prisma can't express one — the raw migration
  // adds a `WHERE latitude IS NOT NULL` variant alongside it.
  @@index([latitude, longitude])
}

model Service {
  id           String        @id @default(cuid())
  shopId       String
  shop         Barbershop    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  name         String
  nameAr       String?
  nameCkb      String?
  // Duration in minutes; price as integer in smallest currency unit (IQD has none).
  durationMin  Int
  price        Int
  isActive     Boolean       @default(true)
  // The "Haircut & Beard Trim" combo every shop carries. Auto-created with each
  // shop and shielded from deletion so quick booking always has a service to
  // preselect. Exactly one per shop. Admins may still rename/reprice it.
  isStandard   Boolean       @default(false)
  reservations Reservation[]

  @@index([shopId])
}

model OpeningHour {
  id          String     @id @default(cuid())
  shopId      String
  shop        Barbershop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  // 0 = Sunday … 6 = Saturday. Times are minutes from local midnight.
  weekday     Int
  openMinute  Int
  closeMinute Int

  @@unique([shopId, weekday])
}

model Barber {
  id           String        @id @default(cuid())
  shopId       String
  shop         Barbershop    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  name         String
  nameAr       String?
  nameCkb      String?
  // Google account email, unique across all barbers. A barber logs into the
  // mobile app with this Google account (same OAuth flow as customers) and the
  // barber dashboard unlocks when it matches this row.
  email        String        @unique
  isActive     Boolean       @default(true)
  // When true, incoming booking requests for this barber are confirmed
  // automatically instead of waiting in the requests queue.
  autoApprove  Boolean       @default(false)
  // Lifetime totals carried over from appointments whose Reservation rows were
  // removed by a customer deleting their account. The privacy policy promises
  // deletion removes that customer's bookings, but the barber's earnings are
  // the BARBER's business record — without this, one customer pressing Delete
  // Account silently reduced someone else's lifetime earnings and cut count.
  // Aggregate-only and customer-free, so nothing personal survives here.
  archivedCuts     Int       @default(0)
  archivedEarnings Int       @default(0)
  createdAt    DateTime      @default(now())
  reservations Reservation[]

  @@index([shopId])
}

model Reservation {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id])
  shopId    String
  shop      Barbershop @relation(fields: [shopId], references: [id])
  serviceId String
  service   Service    @relation(fields: [serviceId], references: [id])
  // Every booking is assigned to a specific barber (chosen or auto-assigned
  // from "any available"). Nullable only to tolerate pre-barber legacy rows.
  barberId  String?
  barber    Barber?    @relation(fields: [barberId], references: [id])
  // Price frozen at booking time so barber earnings stay correct if the
  // service price later changes.
  price     Int        @default(0)
  // UTC instants; duration frozen from the service at booking time.
  startsAt  DateTime
  endsAt    DateTime
  // PENDING (awaiting barber) | CONFIRMED (accepted) | DECLINED (rejected by
  // barber) | CANCELLED (by customer). Past CONFIRMED counts as completed.
  // PENDING and CONFIRMED both hold the slot.
  status    String     @default("PENDING")
  // Set when the ~20-min "your appointment is soon" reminder push has been
  // sent, so the scheduler never reminds the same booking twice.
  reminderSentAt DateTime?
  createdAt DateTime   @default(now())

  @@index([shopId, startsAt])
  @@index([userId, startsAt])
  @@index([barberId, status, startsAt])
  // Reminder sweep looks up confirmed, not-yet-reminded, soon-starting rows.
  @@index([status, reminderSentAt, startsAt])
}

model Notification {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  // BOOKING_ACCEPTED | BOOKING_DECLINED
  type          String
  title         String
  body          String
  reservationId String?
  readAt        DateTime?
  createdAt     DateTime    @default(now())

  @@index([userId, createdAt])
  // Retention sweep deletes read notifications past the cutoff. The feed only
  // ever shows the newest 50, so old rows are pure storage cost — and the
  // Barber-of-the-Week broadcast writes one per user per run.
  @@index([createdAt])
}

model Review {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id])
  shopId    String
  shop      Barbershop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  rating    Int // 1..5
  comment   String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([userId, shopId])
  @@index([shopId, createdAt])
}

model Plan {
  id            String         @id @default(cuid())
  name          String         @unique
  // Monthly price, integer currency units.
  monthlyPrice  Int
  // Marketing bullet points, newline-separated.
  features      String
  // Featured shops sort first in the app list.
  isFeaturedTier Boolean       @default(false)
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  subscriptions Subscription[]
}

// Append-only trail of every state-changing admin action. Admin writes are
// billing events (subscriptions, plan pricing, shop visibility, featured
// placement), so "who changed this and when" has to be answerable after the
// fact. Never updated or deleted by application code; the retention sweep
// trims entries older than AUDIT_RETENTION_DAYS.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  // Denormalized: the trail must stay readable even if the AdminUser row is
  // later removed or renamed.
  actorEmail String
  // Dotted verb, e.g. "shop.visibility" | "subscription.assign" | "plan.delete".
  action     String
  targetType String
  targetId   String?
  // JSON-encoded summary of what changed. A string (not a Json column) keeps
  // the shape opaque and avoids indexing something we only ever read by eye.
  detail     String?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([targetType, targetId, createdAt])
}

model Subscription {
  id                 String     @id @default(cuid())
  shopId             String     @unique
  shop               Barbershop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  planId             String
  plan               Plan       @relation(fields: [planId], references: [id])
  // ACTIVE | CANCELLED  (expiry is derived from currentPeriodEnd)
  status             String     @default("ACTIVE")
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
}
